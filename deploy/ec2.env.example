# Copy to deploy/ec2.env on the server. Never commit the filled file.
APP_IMAGE=YOUR_ACCOUNT.dkr.ecr.YOUR_REGION.amazonaws.com/lifecairn:YOUR_RELEASE
TOOLS_IMAGE=YOUR_ACCOUNT.dkr.ecr.YOUR_REGION.amazonaws.com/lifecairn:YOUR_RELEASE-tools
SITE_ADDRESS=lifecairn.example.com
# Generate a URL-safe password, for example with: openssl rand -hex 32
POSTGRES_PASSWORD=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Telegram bot. Token and username from @BotFather; secret from: openssl rand -hex 32
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Month-end snapshot reminder on Telegram: any long random string (openssl rand -hex 32)
CRON_SECRET=

# Manifestation (separate repo, same EC2, same Clerk instance and Postgres server)
MANIFESTATION_IMAGE=YOUR_ACCOUNT.dkr.ecr.YOUR_REGION.amazonaws.com/manifestation:YOUR_RELEASE
MANIFESTATION_TOOLS_IMAGE=YOUR_ACCOUNT.dkr.ecr.YOUR_REGION.amazonaws.com/manifestation:YOUR_RELEASE-tools
MANIFESTATION_SITE_ADDRESS=manifestation.example.com
# Comma-separated production Clerk user ids (user_...) allowed in; it is a single-profile app.
MANIFESTATION_ALLOWED_USER_IDS=
# Reminders and reports. Email: any SMTP (Mailtrap "Email Sending", not the testing sandbox).
MANIFESTATION_SMTP_HOST=
MANIFESTATION_SMTP_PORT=587
MANIFESTATION_SMTP_USER=
MANIFESTATION_SMTP_PASS=
MANIFESTATION_SMTP_FROM=
# Telegram: token from @BotFather (a bot used only by Manifestation).
MANIFESTATION_TELEGRAM_BOT_TOKEN=
