# Settings for deploy/deploy.sh, on your computer. Copy to deploy/deploy.env
# (git-ignored) and fill in. No secrets of the server go here.

# SSH target and key for the EC2 instance.
EC2_HOST=ubuntu@YOUR_ELASTIC_IP
SSH_KEY=~/.ssh/lifecairn.pem
# Where the repo is checked out on the instance, relative to the server user's home (or a full /home/... path).
REMOTE_DIR=lifecairn

# ECR region; the AWS CLI on this computer must be logged in (aws sts get-caller-identity).
AWS_REGION=eu-central-1
# Optional: AWS_PROFILE=your-profile

# The PRODUCTION Clerk publishable key (pk_live_...). It is baked into the app
# image at build time, so it must match CLERK_SECRET_KEY in deploy/ec2.env on EC2.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
